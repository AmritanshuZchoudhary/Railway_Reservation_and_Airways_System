erDiagram
    USERS ||--o{ BOOKINGS : makes
    TRAINS ||--o{ TRAIN_ROUTES : serves
    STATIONS ||--o{ TRAIN_ROUTES : origin
    STATIONS ||--o{ TRAIN_ROUTES : destination
    TRAIN_ROUTES ||--o{ TRAIN_SCHEDULES : has
    TRAINS ||--o{ TRAIN_SEATS : contains
    TRAIN_SCHEDULES ||--o{ BOOKINGS : receives
    TRAIN_SCHEDULES ||--o{ SEAT_ALLOCATIONS : has
    TRAIN_SEATS ||--o{ SEAT_ALLOCATIONS : assigned_as
    BOOKINGS ||--o| SEAT_ALLOCATIONS : receives
    BOOKINGS ||--o| WAITLIST_ENTRIES : may_enter
    TRAIN_SCHEDULES ||--o{ WAITLIST_ENTRIES : queues
    BOOKINGS ||--o| CANCELLATIONS : cancellation_record
    BOOKINGS ||--o| WAITLIST_PROBABILITY_HISTORY : finalized_outcome
    TRAIN_SCHEDULES ||--o{ CANCELLATIONS : records
